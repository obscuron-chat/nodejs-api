{
  "name": "obscuron-nodejs-core",
  "version": "1.0.0",
  "description": "Obscuron Web-Based Encrypted Chat App",
  "license": "MIT",
  "author": "dev@obscuron.chat",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "lint": "find . -path ./node_modules -prune -o -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/*.test.js",
    "test:ws": "node --test test/*.test.js",
    "test:security": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
