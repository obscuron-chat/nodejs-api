# Obscuron API configuration.
# Copy to .env and replace every value marked replace_me before starting the service.
# Startup validates each key and exits 1 with a redacted reason when one is wrong.

NODE_ENV=development
PORT=8080

# Must include credentials. The documented example below is rejected verbatim,
# so change at least the password before the service will start.
MONGODB_URI=mongodb://admin:local_mongo_root_password_change_me@mongodb:27017/obscuron?authSource=admin

# Both secrets must be at least 32 bytes, must differ from each other, and must
# not equal these documented examples.
JWT_ACCESS_SECRET=local_access_secret_replace_me_32_bytes_minimum
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=local_refresh_secret_replace_me_32_bytes_minimum
REFRESH_COOKIE_NAME=__Host-obscuron_refresh

BCRYPT_COST=12

# Exact allowlists. Production must be exactly https://obscuron.faizath.com.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

WS_MAX_PAYLOAD_BYTES=65536
WS_PERMESSAGE_DEFLATE=false
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_MISSES_ALLOWED=2
WS_MAX_CONNECTIONS_PER_USER=5
WS_MESSAGES_PER_MINUTE=60

AUTH_USERNAME_FAIL_LIMIT=5
AUTH_USERNAME_WINDOW_SECONDS=900
AUTH_USERNAME_LOCKOUT_SECONDS=1800
AUTH_IP_FAIL_LIMIT=20
AUTH_IP_WINDOW_SECONDS=900
AUTH_IP_LOCKOUT_SECONDS=900
REFRESH_USER_LIMIT=10
REFRESH_IP_LIMIT=60
REFRESH_WINDOW_SECONDS=600

# Retained ciphertext lifetime in days: 1-365, default 90.
MESSAGE_RETENTION_DAYS=90

LOG_LEVEL=info
DEBUG=false

# Local Docker Compose only. Production uses a managed MongoDB secret instead.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=local_mongo_root_password_change_me
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=local_mongo_root_password_change_me
ME_CONFIG_MONGODB_SERVER=mongodb
